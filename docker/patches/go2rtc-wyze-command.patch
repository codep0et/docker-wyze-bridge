@@ -0,0 +1,29 @@
+package wyze
+
+import (
+	"encoding/binary"
+	"fmt"
+	"time"
+)
+
+// Command sends one HL control command and waits for its response
+// (command code + 1). Returns the response payload without the HL header.
+func (c *Client) Command(code uint16, payload []byte) ([]byte, error) {
+	b := make([]byte, 16+len(payload))
+	copy(b, "HL")
+	b[2] = 5
+	binary.LittleEndian.PutUint16(b[4:], code)
+	binary.LittleEndian.PutUint16(b[6:], uint16(len(payload)))
+	copy(b[16:], payload)
+
+	resp, err := c.conn.WriteAndWaitIOCtrl(b, c.matchHL(code+1), 5*time.Second)
+	if err != nil {
+		return nil, err
+	}
+
+	hl := c.extractHL(resp)
+	if len(hl) < 16 {
+		return nil, fmt.Errorf("wyze: short response to command %d", code)
+	}
+	return hl[16:], nil
+}
