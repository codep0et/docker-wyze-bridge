+// listenUDP opens the local socket for a camera session. By default the OS
+// picks an ephemeral port. When GO2RTC_WYZE_UDP_PORTS is set ("40000-40015"
+// or "40000"), the first free port in that range is used instead, so the
+// ports can be published from a container that is not on the camera's LAN
+// (Docker Desktop / OrbStack on macOS and Windows).
+func listenUDP() (*net.UDPConn, error) {
+	first, last, ok := udpPortRange(os.Getenv("GO2RTC_WYZE_UDP_PORTS"))
+	if !ok {
+		return net.ListenUDP("udp", nil)
+	}
+	// Rotate through the range: the camera of a just-closed session keeps
+	// sending for a while, so don't hand its port to the next session.
+	size := last - first + 1
+	for i := 0; i < size; i++ {
+		port := first + int(udpPortNext.Add(1)-1)%size
+		if udp, err := net.ListenUDP("udp", &net.UDPAddr{Port: port}); err == nil {
+			return udp, nil
+		}
+	}
+	return nil, fmt.Errorf("no free UDP port in GO2RTC_WYZE_UDP_PORTS=%d-%d", first, last)
+}
+
+var udpPortNext atomic.Uint32
+
+func udpPortRange(s string) (first, last int, ok bool) {
+	lo, hi, isRange := strings.Cut(strings.TrimSpace(s), "-")
+	first, err := strconv.Atoi(lo)
+	if err != nil {
+		return 0, 0, false
+	}
+	last = first
+	if isRange {
+		if last, err = strconv.Atoi(hi); err != nil {
+			return 0, 0, false
+		}
+	}
+	return first, last, first > 0 && first <= last && last <= 65535
+}
